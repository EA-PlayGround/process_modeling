<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/xiaoqi/ontologies/2026/10/process_modeling_tools/"
     xml:base="http://www.semanticweb.org/xiaoqi/ontologies/2026/10/process_modeling_tools/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:process_modeling_tools="http://www.semanticweb.org/v0cn037/ontologies/2026/10/process_modeling_tools#"
     xmlns:process_modeling_tools1="http://www.semanticweb.org/xiaoqi/ontologies/2026/10/process_modeling_tools#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/10/process_modeling_tools">
        <rdfs:comment>Process Modeling Tools Ontology ([http://www.semanticweb.org/xiaoqi/ontologies/2026/10/process_modeling_tools](http://www.semanticweb.org/xiaoqi/ontologies/2026/10/process_modeling_tools)) provides a structured knowledge model of process modeling domains (Level 1), standards and notations (Level 2), and commercial or open-source software tools (Level 3). It captures execution capabilities (DiagrammingOnly, ExecutableEngine, Simulation, ProcessMining), licensing models, standards and vendor certifications, and live ecosystem consolidation via isAcquiredBy relationships. Designed to give practitioners a clear first-glance landscape for hands-on exploration and support community contributions as the tooling market evolves.</rdfs:comment>
    </owl:Ontology>
    


